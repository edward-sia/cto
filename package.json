{
  "name": "cambrian-tree-orchestrator",
  "version": "0.1.0",
  "description": "Cambrian Tree Orchestrator: Tree-of-Thought agent orchestration for software development",
  "author": "Edward Sia",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/edward-sia/cto.git"
  },
  "homepage": "https://github.com/edward-sia/cto",
  "keywords": [
    "tree-of-thought",
    "agent-orchestration",
    "llm",
    "codex",
    "ai",
    "cli",
    "multi-agent",
    "debate"
  ],
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "dist/index.js",
  "bin": {
    "cto": "dist/cli/index.js"
  },
  "scripts": {
    "build": "npm run build:providers && tsc",
    "build:providers": "npm --workspace @cto/llm-providers run build",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "lint": "eslint src/",
    "typecheck": "npm run build:providers && tsc --noEmit",
    "typecheck:providers": "npm --workspace @cto/llm-providers run typecheck",
    "docs:check": "tsx src/docs/impact-check.ts",
    "test": "npm run docs:check && npm run build:providers && vitest run",
    "test:live-providers": "npm run build:providers && CTO_LIVE_PROVIDER_TESTS=1 vitest run --config vitest.live-providers.config.ts",
    "test:watch": "npm run build:providers && vitest"
  },
  "dependencies": {
    "@cto/llm-providers": "file:packages/llm-providers",
    "@openai/codex-sdk": "^0.125.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "js-yaml": "^4.1.1",
    "nanoid": "^5.0.0",
    "openai": "^4.80.0",
    "ora": "^8.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.19",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
